/*
 * Game Console R36S (RK3326)
 *
 * The R36S is electrically very close to the ODROID-GO Super (which is
 * also what ArkOS boots it as), so this builds on the mainline
 * rk3326-odroid-go3.dts and only patches the differences that matter
 * for a headless boot. Differences were taken from the vendor DTB
 * shipped with ArkOS and from ROCKNIX's rk3326-gameconsole-r36s.dts.
 */

#include "rk3326-odroid-go3.dts"

/ {
	model = "Game Console R36S";
	compatible = "gameconsole,r36s", "hardkernel,rk3326-odroid-go3", "rockchip,rk3326";

	aliases {
		mmc0 = &sdmmc;
		mmc1 = &sdio;
	};
};

/*
 * Same GPIOs as the ODROID-GO Super, but the R36S has L3/R3/FN where the
 * ODROID has F3-F6. Verified with evtest.
 */
&builtin_gamepad {
	button-sw11 {
		label = "L3";
		linux,code = <BTN_THUMBL>;
	};

	button-sw12 {
		label = "R3";
		linux,code = <BTN_THUMBR>;
	};

	button-sw13 {
		label = "FN";
		linux,code = <BTN_MODE>;
	};

	/* GPIO2_A5 is not connected */
	/delete-node/ button-sw14;
};

/*
 * Raw stick travel is about 60-900 around a center of ~512. The left
 * stick is mounted the other way round, a reversed abs-range inverts
 * the axis.
 *
 * adc_joystick_invert() in Linux 7.2 looks up the axis range by the
 * channel index instead of the event code, so inverted axes only work
 * when reg == linux,code. The channels are reordered to make that true
 * for ABS_X (0) and ABS_Y (1).
 */
&analog_sticks {
	io-channels = <&joystick_mux 0>,	/* left X */
		      <&joystick_mux 2>,	/* left Y */
		      <&joystick_mux 1>,	/* right X */
		      <&joystick_mux 3>;	/* right Y */

	axis@0 {
		linux,code = <ABS_X>;
		abs-range = <912 112>;
	};

	axis@1 {
		linux,code = <ABS_Y>;
		abs-range = <912 112>;
	};

	axis@2 {
		linux,code = <ABS_RX>;
		abs-range = <112 912>;
	};

	axis@3 {
		linux,code = <ABS_RY>;
		abs-range = <112 912>;
	};
};

&rk817 {
	/*
	 * Restart and power off through the PMIC. The PSCI SYSTEM_RESET of
	 * the vendor BL31 (v1.3, 2018) never returns, so without this
	 * `reboot` hangs after "reboot: Restarting system".
	 */
	system-power-controller;

	regulators {
		/* 5V VBUS for the OTG port, needed for USB WiFi dongles */
		otg_switch: OTG_SWITCH {
			regulator-name = "otg_switch";
			regulator-boot-on;
		};
	};
};

&usb20_otg {
	vbus-supply = <&otg_switch>;
};

/* Second microSD slot ("TF2") */
&sdio {
	bus-width = <4>;
	cap-sd-highspeed;
	card-detect-delay = <800>;
	cd-gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
	disable-wp;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

/*
 * The R36S ships with a number of different panels, none of which have a
 * mainline driver. Use ROCKNIX's panel-generic-dsi driver
 * (drivers/panel-generic-dsi) which takes the whole panel description
 * from the device tree.
 *
 * This is the original 640x480 ST7703 panel ("Panel 0" in the ArkOS
 * panel chooser), converted from the vendor rk3326-r35s-linux.dtb:
 *
 *   G  size=<width_mm>,<height_mm> delays=<prepare>,<reset>,<init>,<enable>,<ready>
 *      (delays in ms), flags are MIPI_DSI_MODE_* bits
 *   M  clock=<kHz> horizontal=<active>,<fp>,<sync>,<bp> vertical=<same>
 *   I  seq=<DCS command + payload> wait=<ms, in hex>
 */
&internal_display {
	compatible = "rocknix,generic-dsi";
	reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
	vdd-supply = <&vcc_lcd>;
	iovcc-supply = <&vcc_lcd>;
	/delete-property/ rotation;
	/delete-property/ IOVCC-supply;
	/delete-property/ VCC-supply;

	panel_description =
		"G size=52,70 delays=2,1,20,120,20 format=rgb888 lanes=4 flags=0xe03",

		"M clock=50000 horizontal=640,450,46,450 vertical=480,17,5,13 default=1",
		"M clock=25500 horizontal=640,188,2,190 vertical=480,13,2,5",
		"M clock=30600 horizontal=640,87,2,87 vertical=480,13,2,5",

		"I seq=b9f11283",
		"I seq=b1000000da80",
		"I seq=b2001370",
		"I seq=b31010282803ff00000000",
		"I seq=b480",
		"I seq=b50a0a",
		"I seq=b67f7f",
		"I seq=b82662f063",
		"I seq=ba338105f90e0e2000000000000000442500900a0000014f01000037",
		"I seq=bc47",
		"I seq=bf021100",
		"I seq=c0737350500000125000",
		"I seq=c153c0323277e1dddd77773333",
		"I seq=c68200bfff00ff",
		"I seq=c7b8000a000000",
		"I seq=c810401e02",
		"I seq=cc0b",
		"I seq=e000070d37353f4144060c0d0f111012141a00070d37353f4144060c0d0f111012141a",
		"I seq=e307070b0b0b0b00000000ff00c010",
		"I seq=e9c810020000b0b11131232880b0b127080004020000000004020000008888ba60240888888888888888ba713518888888888800000001000000000000000000",
		"I seq=ea970a820203070000000000008188ba17538888888888888088ba0642888888888888230000028000000000000000000000000000000000000000000000",
		"I seq=efffff01",
		"I seq=11 wait=c8",
		"I seq=29 wait=32";
};
